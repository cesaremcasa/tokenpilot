{
  "name": "tokenpilot",
  "version": "0.4.17",
  "description": "Local-first token measurement and optimization for Claude Code, OpenAI Codex, Grok Build, and Kimi CLI. Measures provider-published usage, runs version-gated treatments, and produces cache-aware reports without proxying traffic or storing prompts.",
  "private": true,
  "license": "MIT",
  "author": "Mycellium Lab",
  "homepage": "https://github.com/cesaremcasa/tokenpilot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cesaremcasa/tokenpilot.git"
  },
  "bugs": {
    "url": "https://github.com/cesaremcasa/tokenpilot/issues"
  },
  "keywords": [
    "ai",
    "claude",
    "codex",
    "grok",
    "kimi",
    "telemetry",
    "tokens"
  ],
  "type": "module",
  "files": [
    "dist",
    "integrations",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "bin": {
    "tokenpilot": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:install": "node scripts/install-smoke.mjs",
    "release:artifact": "node scripts/release-artifact.mjs",
    "test:release": "node scripts/release-smoke.mjs",
    "dev": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
